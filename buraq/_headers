# Assets are NOT content-hashed — site.mp4, ship.mp4, building.jpg and the
# photographs keep the same filenames while their contents change between
# deploys. `immutable` would tell a browser never to revalidate them for a
# year, so anyone who visited an earlier deploy would keep being served the
# old files. Cache them, but always let a redeploy through.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# The page itself changes on every edit — always revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
