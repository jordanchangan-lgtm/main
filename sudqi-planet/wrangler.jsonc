// Cloudflare Worker that serves sudqiplanet.com: the static site in dist/ plus /api/* (offer counter).
// Deploy: python3 tools/build.py && npx wrangler deploy
{
  "name": "odd-salad-a514",
  "main": "tools/_worker.js",
  "compatibility_date": "2026-10-01",
  // keep what the dashboard had: the custom domain and the workers.dev address
  "routes": [{ "pattern": "sudqiplanet.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only /api/* runs the script; pages and images are served directly with _headers caching
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "OFFER", "id": "bba9a8086f844396aba0a6cbbd0a1cdb" }
  ]
}
