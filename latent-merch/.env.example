# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flag. Leave false (or unset) for marketing-only mode — the cart and
# checkout disappear from the UI and the site can build with no other keys.
# Set to true once Supabase + Stripe are wired up.
NEXT_PUBLIC_COMMERCE_ENABLED=false

# Optional: where the "notify me" CTAs send mail when commerce is off.
NEXT_PUBLIC_WAITLIST_EMAIL=hello@latent.studio

# Only needed when NEXT_PUBLIC_COMMERCE_ENABLED=true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never import client-side) ---
# Only needed when NEXT_PUBLIC_COMMERCE_ENABLED=true.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
