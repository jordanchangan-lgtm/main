# Photographs, logos and fonts are content-addressed by filename — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself changes on every edit — always revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
